@page
@model IdentityServer.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <div class="brand-logo">
        <h2>acme Recruiting</h2>
        <p class="text-muted">Identity Provider</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter your username" autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberLogin" type="checkbox" class="form-check-input" />
            <label asp-for="RememberLogin" class="form-check-label">Remember me</label>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
        </div>
    </form>

    <hr class="my-4" />

    <div class="text-center text-muted">
        <small>Test accounts: alice / Pass123! or bob / Pass123!</small>
    </div>
</div>
