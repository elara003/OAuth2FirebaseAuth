@page
@model IdentityServer.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logged Out";
}

<div class="login-container text-center">
    <div class="brand-logo">
        <h2>UltiPro Recruiting</h2>
        <p class="text-muted">Identity Provider</p>
    </div>

    <h4>You have been logged out</h4>

    @if (!string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
    {
        <p>
            <a href="@Model.PostLogoutRedirectUri">Return to application</a>
        </p>
    }
</div>
